{
  "expo": {
    "name": "DomusPRO",
    "slug": "rent-management-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-logo-symbol-2.png",
    "scheme": "rentmanagementmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow DomusPRO to use Face ID to log you in."
      },
      "bundleIdentifier": "com.anonymous.rent-management-mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/app-logo-symbol-2.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.harrdeepsteam.rentmanagementmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF3131",
          "image": "./assets/images/app-logo-symbol-2.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-local-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "523421e7-f227-42aa-9de9-b977d250c2e0"
      }
    }
  }
}
